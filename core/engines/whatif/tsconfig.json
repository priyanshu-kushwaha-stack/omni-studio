{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@whatif/kit/*": ["src/kit/*"] }
  },
  "include": ["src", "examples", "pipeline", "tests", "remotion.config.ts"]
}
