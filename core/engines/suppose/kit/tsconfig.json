{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@suppose/kit": ["src/index.ts"], "@suppose/kit/*": ["src/*"],
      "react": ["node_modules/@types/react"], "react/*": ["node_modules/@types/react/*"], "remotion": ["node_modules/remotion"]
    }
  },
  "include": ["src", "tests", "../examples", "remotion.config.ts", "vitest.config.ts"]
}
