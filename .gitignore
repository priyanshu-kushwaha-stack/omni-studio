# Environments
.venv/
.venv-media/
__pycache__/
*.pyc
.pytest_cache/

# Secrets live in ~/.config/omni-studio/, never in this repo
.env
*.token

# Media and model weights
*.mp4
*.mov
*.wav
*.safetensors

# Build and tool output
*.egg-info/
node_modules/

# Channels: video text is tracked, assets and renders are not
channels/*/videos/*/assets/
channels/*/videos/*/renders/
channels/*/videos/*/events.jsonl
channels/*/lora/*
!channels/*/lora/.gitkeep
channels/*/.board.json
# omni new-channel makes these links. They are not committed.
core/openmontage/styles/custom/*.yaml
*.mp3
*.m4a
# Channel media that stays local: built rig cut-outs, narration stems, per-video rig parts, music cues.
# Rig specs (rigs/*.json), the LoRA notes and the channel font are tracked.
channels/*/rigs/*/
channels/*/videos/*/narration/
channels/*/videos/*/rigs/*/
channels/*/music/
!channels/*/lora/README.md
!channels/*/lora/train.json
# Reference clips: metadata (core/reference/**/*.yaml) is tracked, media is not.
core/reference/**/media/
# Pinned outside binaries (core/lock.yaml), installed by omni upload --install
.tools/
# omni qc reports are re-run by omni approve; local evidence only
channels/*/videos/*/qc/

# Channel page: the final picture, banner and watermark are tracked; candidates and preview crops are not.
channels/*/page/candidates/
channels/*/page/crops/
# Quality room: raw CLI output per call (verdicts and summaries are tracked)
channels/*/videos/*/room/raw/
# Quality room: the live canary written by the sandbox check
.room-canary
