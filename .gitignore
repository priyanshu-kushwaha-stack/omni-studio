# Environments
.venv/
.venv-media/
__pycache__/
*.pyc
.pytest_cache/

# Secrets live in ~/.config/omni-studio/, never in this repo
.env
*.token

# Media and model weights
*.mp4
*.mov
*.wav
*.safetensors

# Build and tool output
*.egg-info/
node_modules/

# Channels: video text is tracked, assets and renders are not
channels/*/videos/*/assets/
channels/*/videos/*/renders/
channels/*/videos/*/events.jsonl
channels/*/lora/*
!channels/*/lora/.gitkeep
channels/*/.board.json
# omni new-channel makes these links. They are not committed.
core/openmontage/styles/custom/*.yaml
*.mp3
*.m4a
# Channel media that stays local: built rig cut-outs, narration stems, per-video rig parts, music cues.
# Rig specs (rigs/*.json), the LoRA notes and the channel font are tracked.
channels/*/rigs/*/
channels/*/videos/*/narration/
channels/*/videos/*/rigs/*/
channels/*/music/
!channels/*/lora/README.md
!channels/*/lora/train.json
